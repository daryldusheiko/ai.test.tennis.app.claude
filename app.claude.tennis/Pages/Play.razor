@page "/"
@inject ScheduleService Schedules
@inject AppStart Start
@inject NavigationManager Navigation

<PageTitle>Social Tennis</PageTitle>

@if (_loading)
{
    <p class="page-message">Loading…</p>
}
else if (_schedule is not { Step: ScheduleStep.InPlay })
{
    <div class="page-section">
        <p class="page-message">No schedule in play.</p>
        <p class="page-message">@(_schedule is null ? "Create one on the Schedule page." : "Finish setting it up on the Schedule page, then tap Play.")</p>
    </div>
}
else
{
    <div class="page-section">
        <ScheduleCards Schedule="_schedule" ShowCourts="true" OnRoundAction="OpenRound" />
        <div class="form-buttons">
            <button type="button" class="button" @onclick="() => _confirmClose = true">Close schedule</button>
        </div>
    </div>
}

@if (_schedule is not null && _dialogRound is { } index && index < _schedule.Rounds.Count)
{
    var inPlay = RoundProgress.InPlayIndex(_schedule);
    <RoundActionDialog Number="index + 1" Status="_schedule.Rounds[index].Status" OtherInPlay="inPlay is { } other && other != index ? other + 1 : null"
                       OnStart="() => ApplyAsync(RoundProgress.Start)" OnFinish="() => ApplyAsync(RoundProgress.Finish)"
                       OnCancelRound="() => ApplyAsync(RoundProgress.Cancel)" OnClose="CloseDialog" />
}

@if (_confirmClose)
{
    <ConfirmDialog Title="Close this schedule?" Message="The schedule and all its rounds will be deleted. Your players are kept. This can't be undone."
                   ConfirmText="Close schedule" OnConfirm="CloseScheduleAsync" OnCancel="() => _confirmClose = false" />
}

@code {
    private bool _loading = true;
    private Schedule? _schedule;
    private int? _dialogRound;
    private bool _confirmClose;

    protected override async Task OnInitializedAsync()
    {
        _schedule = await Schedules.GetAsync();

        // Opening the app with nothing in play starts on Players; after that, Play stays on Play.
        if (Start.TakePlayCheck() && _schedule is not { Step: ScheduleStep.InPlay })
        {
            Navigation.NavigateTo("players", replace: true);
            return;
        }

        _loading = false;
    }

    private async Task CloseScheduleAsync()
    {
        await Schedules.DeleteAsync();
        _schedule = null;
        _dialogRound = null;
        _confirmClose = false;
    }

    private void OpenRound(int index) => _dialogRound = index;

    private void CloseDialog() => _dialogRound = null;

    private async Task ApplyAsync(Func<Schedule, int, Schedule> action)
    {
        if (_schedule is not null && _dialogRound is { } index)
        {
            _schedule = action(_schedule, index);
            await Schedules.SaveAsync(_schedule);
        }

        _dialogRound = null;
    }
}
