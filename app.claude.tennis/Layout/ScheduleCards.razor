@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@{
    var names = new PlayerNames(Schedule.Players);
    var repeats = ShowMarks ? ScheduleEditor.RepeatPairs(Schedule) : [];
}

<div class="round-list" @ref="_root" data-swapping="@(Swap is null ? "false" : "true")">
    @for (var roundIndex = 0; roundIndex < Schedule.Rounds.Count; roundIndex++)
    {
        var round = Schedule.Rounds[roundIndex];
        var number = roundIndex + 1;
        var thisRound = roundIndex;
        <section class="round-card" aria-label="Round @number" data-index="@roundIndex">
            <header class="round-header">
                <h3>Round @number</h3>
                @if (ShowCourts && round.Status != RoundStatus.NotStarted)
                {
                    <span class="round-status">@(round.Status == RoundStatus.InPlay ? "In play" : "Complete")</span>
                }
                @if (ShowCourts)
                {
                    <button type="button" class="round-action" aria-label="Round @number actions" disabled="@(round.Status == RoundStatus.Complete)"
                            @onclick="() => OnRoundAction.InvokeAsync(thisRound)">⋮</button>
                }
                @if (Reorderable && !round.IsComplete)
                {
                    <button type="button" class="drag-handle" data-drag="round" aria-label="Move round @number">||</button>
                }
            </header>
            @for (var gameIndex = 0; gameIndex < round.Games.Count; gameIndex++)
            {
                var game = round.Games[gameIndex];
                var clash = IsRankClash(game, names);
                <div class="game-row@(clash ? " rank-clash" : string.Empty)" data-index="@gameIndex">
                    @if (ShowCourts)
                    {
                        <CourtBall Court="CourtFor(gameIndex)" Status="round.Status" />
                    }
                    <div class="team">
                        @foreach (var id in game.Team1)
                        {
                            @Player(roundIndex, round, id, names, repeats)
                        }
                    </div>
                    <span class="versus" aria-hidden="true">v</span>
                    <div class="team">
                        @foreach (var id in game.Team2)
                        {
                            @Player(roundIndex, round, id, names, repeats)
                        }
                    </div>
                    @if (clash)
                    {
                        <span class="visually-hidden">A rank 1 player plays a rank 3 player.</span>
                    }
                    @if (Reorderable && !game.IsComplete)
                    {
                        <button type="button" class="drag-handle" data-drag="game" aria-label="Move game @(gameIndex + 1) of round @number">||</button>
                    }
                </div>
            }
            @if (round.SittingOut.Count > 0)
            {
                <p class="sitting-out">
                    Sitting out:
                    @foreach (var id in round.SittingOut)
                    {
                        @Player(roundIndex, round, id, names, repeats)
                    }
                </p>
            }
        </section>
    }
</div>

@code {
    /// <summary>How long a name must be pressed to count as a hold.</summary>
    internal const int HoldMilliseconds = 500;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _attached;
    private IJSObjectReference? _holdModule;
    private IJSObjectReference? _holdAttached;
    private DotNetObjectReference<ScheduleCards>? _self;

    [Parameter, EditorRequired]
    public Schedule Schedule { get; set; } = null!;

    [Parameter]
    public bool ShowCourts { get; set; }

    [Parameter]
    public bool ShowRank { get; set; }

    /// <summary>Reports the round whose action button (⋮) was pressed. The button shows with the courts.</summary>
    [Parameter]
    public EventCallback<int> OnRoundAction { get; set; }

    /// <summary>Shows the drag handles. Needs <see cref="Editable"/>.</summary>
    [Parameter]
    public bool Reorderable { get; set; }

    /// <summary>The review page: listens for dragging and for press-and-hold on names.</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Names are buttons that can be held (edit mode).</summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>Shows red (second partnership) and blue (moved) names.</summary>
    [Parameter]
    public bool ShowMarks { get; set; }

    /// <summary>The player waiting to be swapped, highlighted.</summary>
    [Parameter]
    public PlayerSpot? Swap { get; set; }

    [Parameter]
    public EventCallback<PlayerSpot> OnPlayerHold { get; set; }

    [Parameter]
    public EventCallback<PlayerSpot> OnPlayerTap { get; set; }

    [Parameter]
    public EventCallback<RoundMove> OnMoveRound { get; set; }

    [Parameter]
    public EventCallback<GameMove> OnMoveGame { get; set; }

    [JSInvokable]
    public async Task Reorder(string kind, int round, int from, int to)
    {
        if (kind == "round")
        {
            await OnMoveRound.InvokeAsync(new RoundMove(from, to));
        }
        else
        {
            await OnMoveGame.InvokeAsync(new GameMove(round, from, to));
        }
    }

    [JSInvokable]
    public Task PlayerHeld(int round, string player) => OnPlayerHold.InvokeAsync(new PlayerSpot(round, Guid.Parse(player)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Editable)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/reorder.js");
            _attached = await _module.InvokeAsync<IJSObjectReference>("attach", _root, _self);
            _holdModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/hold.js");
            _holdAttached = await _holdModule.InvokeAsync<IJSObjectReference>("attach", _root, _self, HoldMilliseconds);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_attached is not null)
            {
                await _attached.InvokeVoidAsync("dispose");
                await _attached.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }

            if (_holdAttached is not null)
            {
                await _holdAttached.InvokeVoidAsync("dispose");
                await _holdAttached.DisposeAsync();
            }

            if (_holdModule is not null)
            {
                await _holdModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is closing; there is nothing left to tidy up.
        }

        _self?.Dispose();
    }

    private RenderFragment Player(int roundIndex, Round round, Guid id, PlayerNames names, IReadOnlyList<RepeatPair> repeats)
    {
        var mark = repeats.Any(repeat => repeat.Rounds.Contains(roundIndex) && repeat.Pair.Contains(id)) ? PlayerMark.Repeat
            : round.Changed.Contains(id) ? PlayerMark.Changed
            : PlayerMark.None;
        var label = new RenderFragment(builder =>
        {
            builder.OpenComponent<PlayerLabel>(0);
            builder.AddComponentParameter(1, nameof(PlayerLabel.Name), names.NameOf(id));
            builder.AddComponentParameter(2, nameof(PlayerLabel.Rank), RankOf(names, id));
            builder.AddComponentParameter(3, nameof(PlayerLabel.ShowRank), ShowRank);
            builder.AddComponentParameter(4, nameof(PlayerLabel.Pinned), round.Pinned.Contains(id));
            builder.AddComponentParameter(5, nameof(PlayerLabel.Mark), mark);
            builder.CloseComponent();
        });
        if (!Editing)
        {
            return label;
        }

        var spot = new PlayerSpot(roundIndex, id);
        var selected = Swap == spot;
        return builder =>
        {
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "type", "button");
            builder.AddAttribute(2, "class", selected ? "player-button selected" : "player-button");
            builder.AddAttribute(3, "data-player", id.ToString());
            builder.AddAttribute(4, "data-round", roundIndex.ToString(System.Globalization.CultureInfo.InvariantCulture));
            builder.AddAttribute(5, "aria-pressed", selected ? "true" : "false");
            builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => OnPlayerTap.InvokeAsync(spot)));
            builder.AddContent(7, label);
            builder.CloseElement();
        };
    }

    private static int? RankOf(PlayerNames names, Guid id) => names.Players.GetValueOrDefault(id)?.Rank;

    // Rule 7 lets a 1 play a 3 in singles only when nothing else works, and that game is shown in red.
    private static bool IsRankClash(Game game, PlayerNames names) =>
        game.Team1.Count == 1 && game.Team2.Count == 1
        && (RankOf(names, game.Team1[0]), RankOf(names, game.Team2[0])) is (1, 3) or (3, 1);

    private int CourtFor(int gameIndex) => gameIndex < Schedule.Courts.Count ? Schedule.Courts[gameIndex] : 0;
}
