@inject PlayerService PlayerStore

<div class="page-section">
    <h2>Players</h2>

    @if (_all is null)
    {
        <p class="page-message">Loading…</p>
    }
    else if (_all.Count == 0)
    {
        <p class="page-message">No players yet. <a href="players">Add players</a> first, then come back.</p>
        <div class="form-buttons">
            <button type="button" class="button" @onclick="BackAsync">Back</button>
        </div>
    }
    else
    {
        <PlayerPicker Label="Add players" InputId="add-players" All="_all" Excluded="ChosenIds" Disabled="_generating" OnAdd="AddAsync" />

        <h3>Playing (@_chosen.Count)</h3>
        @if (_chosen.Count == 0)
        {
            <p class="page-message">Nobody added yet.</p>
        }
        else
        {
            <ul class="player-list">
                @foreach (var player in _chosen)
                {
                    <li>
                        <span class="player-name"><span>@player.FirstName</span> <span>@player.LastName</span></span>
                        <button type="button" class="button" aria-label="Remove @player.FullName" disabled="@_generating" @onclick="() => RemoveAsync(player)">Remove</button>
                    </li>
                }
            </ul>
        }

        @if (_chosen.Count < ScheduleEngine.MinPlayers)
        {
            <p class="page-message">Add at least 4 players.</p>
        }

        @if (_generating)
        {
            <p class="page-message" role="status">Matching players…</p>
        }

        <div class="form-buttons">
            <button type="button" class="button" disabled="@_generating" @onclick="BackAsync">Back</button>
            <button type="button" class="button primary" disabled="@(_chosen.Count < ScheduleEngine.MinPlayers || _generating)" @onclick="NextAsync">Next</button>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Player>? _all;
    private List<SchedulePlayer> _chosen = [];
    private bool _generating;

    [Parameter, EditorRequired]
    public IReadOnlyList<SchedulePlayer> Chosen { get; set; } = [];

    /// <summary>Called after every add or remove so the list is saved as it changes.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<SchedulePlayer>> OnChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<SchedulePlayer>> OnBack { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<SchedulePlayer>> OnNext { get; set; }

    private IReadOnlySet<Guid> ChosenIds => _chosen.Select(player => player.Id).ToHashSet();

    protected override async Task OnInitializedAsync()
    {
        _chosen = [.. Chosen];
        _all = await PlayerStore.GetAllAsync();
    }

    private async Task AddAsync(Player player)
    {
        if (_chosen.Any(existing => existing.Id == player.Id))
        {
            return;
        }

        _chosen.Add(new SchedulePlayer(player.Id, player.FirstName, player.LastName, player.Rank));
        await OnChanged.InvokeAsync(_chosen);
    }

    private async Task RemoveAsync(SchedulePlayer player)
    {
        _chosen.Remove(player);
        await OnChanged.InvokeAsync(_chosen);
    }

    private Task BackAsync() => OnBack.InvokeAsync(_chosen);

    private async Task NextAsync()
    {
        _generating = true;
        StateHasChanged();

        // Generation runs on the one browser thread, so let the "Matching players…" message paint first.
        await Task.Delay(50);
        await OnNext.InvokeAsync(_chosen);
    }
}
